DATABASE_URL=postgresql+psycopg2://squadsync:password@localhost:5432/squadsync
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# --- Optional ---
# Enables AI normalization of free-text "Other" strengths (deterministic fallback when unset).
# ANTHROPIC_API_KEY=sk-ant-...
# Model used only for optional free-text strength normalization.
# CATEGORIZATION_MODEL=claude-haiku-4-5-20251001
# Model used only for optional team rationale generation.
# RATIONALE_MODEL=claude-haiku-4-5-20251001
# Hard ceiling (sats) on a single team payout; a safety net against a fat-finger amount.
# PAYOUT_MAX_SATS=5000000
# Optional feedback DM sender. Leave unset for local development.
# SQUADSYNC_NSEC=nsec1...
# FEEDBACK_NPUB=npub1...
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
